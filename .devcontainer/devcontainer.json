{
  "name": "Toronto City Tools",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  },
  "updateContentCommand": "pip3 install --user -e '.[dev]' && cd frontend && npm ci",
  "postAttachCommand": {
    "api": "uvicorn api.main:app --reload --port 8000",
    "frontend": "cd frontend && npm run dev -- --host"
  },
  "portsAttributes": {
    "5173": { "label": "Frontend", "onAutoForward": "openPreview" },
    "8000": { "label": "API" }
  },
  "forwardPorts": [5173, 8000]
}
